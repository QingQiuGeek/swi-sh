# 复制本文件为 .env 后填入真实值（.gitignore 已忽略 .env*，不会提交）。
# 客服助手使用 OpenAI 兼容接口，以下四项都从环境变量读取。

# 提供方名称，仅用于标识与日志（createOpenAICompatible 的 name）
AI_PROVIDER_NAME=qwen3.7-flash-2026-07-15

# 接口地址，需带 /v1 这类版本前缀
AI_BASE_URL=https://llm-e8fm2yf0xdc61oth.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 接口密钥
AI_API_KEY=xxx

# 模型 id
AI_MODEL=qwen3.7-flash-2026-07-15

# 账户 / 会话 / 订单 / 客服聊天记录存 Upstash Redis（产品、指引、案例仍是本地 mock JSON）。
# 在 Vercel 里接好 Upstash 集成后这几项会自动写入；本地开发从 Upstash 控制台复制即可。
# 应用实际读取的是 URL + TOKEN 两项，其余是集成顺带写入的，可以留空。
# 也支持无前缀的 KV_REST_API_URL / KV_REST_API_TOKEN / UPSTASH_REDIS_REST_URL 等名字。
swi_KV_REST_API_URL=
swi_KV_REST_API_TOKEN=
swi_KV_REST_API_READ_ONLY_TOKEN=
swi_KV_URL=
swi_REDIS_URL=


# vercel supabase
swi_SUPABASE_ANON_KEY=
NEXT_PUBLIC_swi_SUPABASE_PUBLISHABLE_KEY=
swi_SUPABASE_URL=
swi_POSTGRES_DATABASE=
swi_POSTGRES_HOST=
swi_POSTGRES_PASSWORD=
swi_POSTGRES_PRISMA_URL=
swi_POSTGRES_URL=
swi_POSTGRES_URL_NON_POOLING=
swi_POSTGRES_USER=
swi_SUPABASE_ANON_KEY=
swi_SUPABASE_JWT_SECRET=
NEXT_PUBLIC_swi_SUPABASE_PUBLISHABLE_KEY=
swi_SUPABASE_SECRET_KEY=
swi_SUPABASE_SERVICE_ROLE_KEY=
swi_SUPABASE_URL=
# Auth.js / NextAuth v5：变量名是框架硬编码的，不能加 swi_ 前缀（见 docs/AUTHJS-PLAN.md §5）
# AUTH_SECRET 用 
px auth secret 或 openssl rand -base64 33 生成；以下键名都留空，切勿提交真实值。
AUTH_SECRET=
AUTH_URL=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=
